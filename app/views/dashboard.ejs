<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - WordPress Automation</title>
    <link rel="stylesheet" href="/css/style.css">
    <!-- TinyMCE Editor (WordPress Standard) -->
    <script
        src="https://cdn.tiny.cloud/1/<%= (config.tinymce && config.tinymce.apiKey) ? config.tinymce.apiKey : 'no-api-key' %>/tinymce/6/tinymce.min.js"
        referrerpolicy="origin"></script>
</head>

<body>
    <%- include('partials/header') %>

        <div class="container">
            <!-- Statistics at the very top -->
            <div class="stats-grid" style="margin-bottom: 2rem;">
                <div class="stat-card">
                    <div class="stat-icon stat-icon-blue">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke-width="2" />
                            <polyline points="14,2 14,8 20,8" stroke-width="2" />
                        </svg>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value">
                            <%= articles.length %>
                        </div>
                        <div class="stat-label">Total Articles</div>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon stat-icon-green">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <polyline points="22,12 18,12 15,21 9,3 6,12 2,12" stroke-width="2" stroke-linecap="round"
                                stroke-linejoin="round" />
                        </svg>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value">
                            <%= config.automation.enabled ? 'Active' : 'Inactive' %>
                        </div>
                        <div class="stat-label">Automation</div>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon stat-icon-purple">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <circle cx="12" cy="12" r="10" stroke-width="2" />
                            <polyline points="12,6 12,12 16,14" stroke-width="2" stroke-linecap="round" />
                        </svg>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value">
                            <%= config.automation.schedule || 'N/A' %>
                        </div>
                        <div class="stat-label">Schedule</div>
                    </div>
                </div>
            </div>

            <div class="dashboard-grid">
                <!-- Quick Actions -->
                <div class="card card-primary">
                    <div class="card-header">
                        <h2>Quick Actions</h2>
                    </div>
                    <div class="card-body">
                        <div class="quick-actions">
                            <a href="/settings" class="btn btn-secondary" style="width: 100%;">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                    <circle cx="12" cy="12" r="3" stroke-width="2" />
                                    <path d="M12 1v6m0 6v6M23 12h-6m-6 0H1" stroke-width="2" stroke-linecap="round" />
                                </svg>
                                Configure Settings
                            </a>
                            <a href="/settings" class="btn btn-secondary">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                    <circle cx="12" cy="12" r="3" stroke-width="2" />
                                    <path d="M12 1v6m0 6v6M23 12h-6m-6 0H1" stroke-width="2" stroke-linecap="round" />
                                </svg>
                                Settings
                            </a>
                        </div>
                    </div>
                </div>

                <!-- AI Article Writer (Main Section) -->
                <div class="card" style="grid-column: 1 / -1; order: -1;">
                    <div class="card-header">
                        <h2>AI Article Writer</h2>
                    </div>
                    <div class="card-body">
                        <form id="generateForm">
                            <div class="form-row">
                                <div class="form-group" style="flex: 2;">
                                    <label for="topic">Topic *</label>
                                    <input type="text" id="topic" name="topic" required
                                        placeholder="e.g., Benefits of Cloud Computing">
                                </div>
                                <div class="form-group" style="flex: 1;">
                                    <label for="keywords">Keywords</label>
                                    <input type="text" id="keywords" name="keywords"
                                        placeholder="cloud, scalability...">
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label for="tone">Tone</label>
                                    <select id="tone" name="tone">
                                        <option value="professional">Professional</option>
                                        <option value="casual">Casual</option>
                                        <option value="technical">Technical</option>
                                        <option value="friendly">Friendly</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="articleLength">Length</label>
                                    <select id="articleLength" name="articleLength">
                                        <option value="500-800">Short (500-800)</option>
                                        <option value="1000-1500" selected>Medium (1000-1500)</option>
                                        <option value="2000-2500">Long (2000-2500)</option>
                                        <option value="3000+">Very Long (3000+)</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="categorySelect">Category</label>
                                    <select id="categorySelect" name="categorySelect">
                                        <option value="">Select...</option>
                                    </select>
                                </div>
                            </div>

                            <details
                                style="margin-bottom: 1rem; background: var(--bg-tertiary); padding: 1rem; border-radius: 8px; border: 1px solid #e5e7eb;">
                                <summary
                                    style="cursor: pointer; font-weight: 600; font-size: 1.1rem; color: var(--primary); padding: 0.5rem;">
                                    ⚙️ Advanced Settings & Configuration</summary>
                                <div style="padding-top: 1.5rem;">

                                    <!-- Simplified Settings - No Tabs -->

                                    <!-- Simple Form Fields -->

                                    <!-- Custom Prompt -->
                                    <div class="form-group">
                                        <label for="customPrompt">✍️ Custom Instructions</label>
                                        <textarea id="customPrompt" name="customPrompt" rows="6"
                                            style="font-family: 'Inter', monospace; font-size: 14px;"
                                            placeholder="Add specific instructions for the AI (e.g., 'Write in a conversational tone', 'Include statistics', etc.)"><%= (config.dashboardPreferences && config.dashboardPreferences.customPrompt) || '' %></textarea>
                                        <small style="color: #6b7280; display: block; margin-top: 0.5rem;">Optional: Add
                                            custom instructions to guide the AI's writing style</small>
                                    </div>

                                    <!-- Count Settings -->
                                    <div class="form-row">
                                        <div class="form-group">
                                            <label for="internalLinksCount">🔗 Internal Links</label>
                                            <input type="number" id="internalLinksCount" name="internalLinksCount"
                                                value="<%= (config.dashboardPreferences && config.dashboardPreferences.internalLinksCount) || 3 %>"
                                                min="0" max="10" placeholder="3">
                                        </div>

                                        <div class="form-group">
                                            <label for="outboundLinksCount">🌐 Outbound Links</label>
                                            <input type="number" id="outboundLinksCount" name="outboundLinksCount"
                                                value="<%= (config.dashboardPreferences && config.dashboardPreferences.outboundLinksCount) || 2 %>"
                                                min="0" max="10" placeholder="2">
                                        </div>
                                    </div>

                                    <div class="form-row">
                                        <div class="form-group">
                                            <label for="imagesCount">🖼️ Images</label>
                                            <input type="number" id="imagesCount" name="imagesCount"
                                                value="<%= (config.dashboardPreferences && config.dashboardPreferences.imagesCount) || 1 %>"
                                                min="0" max="10" placeholder="1">
                                        </div>

                                        <div class="form-group">
                                            <label for="readAlsoCount">📚 Read Also Links</label>
                                            <input type="number" id="readAlsoCount" name="readAlsoCount"
                                                value="<%= (config.dashboardPreferences && config.dashboardPreferences.readAlsoCount) || 3 %>"
                                                min="0" max="10" placeholder="3">
                                        </div>
                                    </div>

                                    <div
                                        style="margin-top: 1rem; padding: 1rem; background: #f0f9ff; border-left: 4px solid #3b82f6; border-radius: 4px;">
                                        <p style="margin: 0; font-size: 14px; color: #1e40af;">
                                            💡 <strong>Note:</strong> All other settings (API keys, WordPress config,
                                            automation, AI models, etc.) are configured in the backend and will be
                                            applied automatically.
                                        </p>
                                    </div>

                                    <!-- Added Save Button -->
                                    <div style="margin-top: 1rem; text-align: right;">
                                        <button type="button" id="saveDashboardPrefs" class="btn btn-secondary"
                                            style="padding: 0.5rem 1rem; font-size: 0.9rem;">
                                            💾 Save View Preferences
                                        </button>
                                    </div>


                                </div>


                            </details>

                            <div class="form-actions" id="generateActions">
                                <button type="submit" class="btn btn-primary"
                                    style="width: 100%; padding: 1rem; font-size: 1.1rem;">
                                    🚀 Generate Article
                                </button>
                            </div>
                        </form>

                        <div id="generatedArticle" style="display: none; margin-top: 2rem;">
                            <div class="generated-content">
                                <h3 id="generatedTitle" style="margin-bottom: 1rem; color: var(--text-primary);"></h3>
                                <div id="articleEditor"
                                    style="height: 600px; background: white; border: 1px solid #ddd;">
                                </div>
                            </div>

                            <div id="publishOptions"
                                style="display: none; margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid #eee;">
                                <div class="form-row" style="align-items: center;">
                                    <div class="form-group" style="margin-bottom: 0;">
                                        <select id="publishStatus" style="padding: 0.5rem;">
                                            <option value="draft">Save as Draft</option>
                                            <option value="publish">Publish Immediately</option>
                                        </select>
                                    </div>
                                    <div class="form-actions" style="margin-left: auto;">
                                        <button type="button" class="btn btn-secondary"
                                            onclick="resetGenerateForm()">New
                                            Article</button>
                                        <button type="button" class="btn btn-primary" onclick="publishArticle()">Save /
                                            Publish</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Progress Overlay/Indicator -->
                        <div id="loadingIndicator" style="display: none; margin-top: 1rem; text-align: center;">
                            <div class="progress-bar-container"
                                style="height: 4px; background: #eee; border-radius: 2px; overflow: hidden;">
                                <div class="progress-bar" id="overallProgress"
                                    style="height: 100%; width: 0%; background: var(--primary); transition: width 0.5s;">
                                </div>
                            </div>
                            <p id="progressPercentage"
                                style="font-size: 0.9rem; color: var(--text-secondary); margin-top: 0.5rem;">
                                Connecting...</p>
                        </div>
                    </div>
                </div>


                <!-- Recent Articles -->
                <div class="card">
                    <div class="card-header">
                        <h2>Recent Articles</h2>
                    </div>
                    <div class="card-body">
                        <% if (articles.length===0) { %>
                            <div class="empty-state">
                                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                                        stroke-width="2" />
                                    <polyline points="14,2 14,8 20,8" stroke-width="2" />
                                </svg>

                                <p>No articles published yet</p>
                                <button class="btn btn-primary" onclick="showGenerateModal()">Create Your First
                                    Article</button>
                            </div>
                            <% } else { %>
                                <div class="articles-list">
                                    <% articles.forEach(article=> { %>
                                        <div class="article-item">
                                            <div class="article-info">
                                                <h3>
                                                    <%= article.title %>
                                                </h3>
                                                <div class="article-meta">
                                                    <span class="badge badge-<%= article.status %>">
                                                        <%= article.status %>
                                                    </span>
                                                    <span class="article-date">
                                                        <%= new Date(article.date).toLocaleDateString() %>
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="article-actions">
                                                <% if (article.link) { %>
                                                    <a href="<%= article.link %>" target="_blank"
                                                        class="btn btn-sm btn-secondary">View</a>
                                                    <% } %>
                                            </div>
                                        </div>
                                        <% }) %>
                                </div>
                                <% } %>
                    </div>
                </div>
            </div>
        </div>

        </div>

        <!-- Live Article Modal (TinyMCE) -->
        <div id="liveArticleModal" class="modal" style="display: none;">
            <div class="modal-content"
                style="max-width: 1400px; width: 95%; height: 90vh; display: flex; flex-direction: column;">
                <div class="modal-header"
                    style="background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%); color: white; flex-shrink: 0;">
                    <h2 style="margin: 0; font-size: 1.5rem;">📝 AI Article Editor</h2>
                    <div style="display: flex; align-items: center; gap: 1rem;">
                        <div id="editorStatus" style="font-size: 0.875rem; opacity: 0.9;">
                            Ready to generate
                        </div>
                        <button onclick="closeLiveArticleModal()"
                            style="background: none; border: none; color: white; font-size: 1.5rem; cursor: pointer; padding: 0 0.5rem;">&times;</button>
                    </div>
                </div>
                <div class="modal-body" style="padding: 0; flex: 1; display: flex; flex-direction: column;">
                    <!-- TinyMCE Editor -->
                    <textarea id="articleEditor" style="width: 100%; height: 100%;">
                        <h1>Welcome to AI Article Writer</h1>
                        <p>Click "Generate Article with AI" above to start writing. The AI will write the article here in real-time!</p>
                    </textarea>
                </div>
                <div
                    style="padding: 1rem; border-top: 1px solid var(--border-color); background: var(--bg-secondary); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; flex-shrink: 0;">
                    <div id="generationStatus"
                        style="color: var(--text-muted); font-size: 0.875rem; display: flex; align-items: center; gap: 10px;">
                        <span>✅ Ready</span>
                    </div>
                    <div style="display: flex; gap: 10px; flex-wrap: wrap; align-items: center;">
                        <select id="livePublishStatus" class="form-select"
                            style="padding: 0.5rem; border-radius: 0.375rem; border: 1px solid var(--border-color); background: var(--bg-primary); color: var(--text-primary);">
                            <option value="publish" selected>🚀 Publish Now</option>
                            <option value="draft">📝 Save as Draft</option>
                            <option value="pending">⏳ Pending Review</option>
                        </select>
                        <button onclick="closeLiveArticleModal()" class="btn btn-secondary">
                            Close
                        </button>
                        <button id="publishBtn" onclick="publishArticle()" class="btn btn-primary"
                            style="background-color: #059669; display: none;">
                            📤 Publish to WordPress
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Blocking Overlay for Image Generation -->
        <div id="imageGenerationOverlay"
            style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); z-index: 10000; flex-direction: column; justify-content: center; align-items: center; color: white;">
            <div style="text-align: center; max-width: 600px; padding: 2rem;">
                <div class="spinner-border text-light" role="status"
                    style="width: 4rem; height: 4rem; margin-bottom: 2rem;"></div>
                <h2 style="font-size: 2rem; margin-bottom: 1rem; font-weight: 700;">We are generating images...</h2>
                <p style="font-size: 1.2rem; opacity: 0.9; margin-bottom: 2rem;">Please wait while we create visuals for
                    your article. This ensures high quality results.</p>

                <div class="progress"
                    style="height: 8px; background: rgba(255,255,255,0.1); border-radius: 4px; overflow: hidden;">
                    <div id="imageGenProgress" class="progress-bar bg-white" role="progressbar"
                        style="width: 0%; transition: width 0.3s ease;"></div>
                </div>
                <p id="imageGenStatus"
                    style="margin-top: 15px; font-size: 0.9rem; color: #aaa; font-family: monospace;">Initializing image
                    generator...</p>
            </div>
        </div>

        <script src="/js/dashboard.js"></script>
        <script>
            document.getElementById('saveDashboardPrefs').addEventListener('click', async function () {
                const btn = this;
                const originalText = btn.innerHTML;
                btn.innerHTML = '💾 Saving...';
                btn.disabled = true;

                const data = {
                    customPrompt: document.getElementById('customPrompt').value,
                    internalLinksCount: document.getElementById('internalLinksCount').value,
                    outboundLinksCount: document.getElementById('outboundLinksCount').value,
                    imagesCount: document.getElementById('imagesCount').value,
                    readAlsoCount: document.getElementById('readAlsoCount').value
                };

                try {
                    const response = await fetch('/api/save-dashboard-preferences', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                    const result = await response.json();

                    if (result.success) {
                        btn.innerHTML = '✅ Saved!';
                        btn.style.backgroundColor = '#d1fae5';
                        btn.style.borderColor = '#34d399';
                        setTimeout(() => {
                            btn.innerHTML = originalText;
                            btn.style.backgroundColor = '';
                            btn.style.borderColor = '';
                            btn.disabled = false;
                        }, 2000);
                    } else {
                        alert('Failed to save: ' + result.message);
                        btn.innerHTML = originalText;
                        btn.disabled = false;
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert('Error saving preferences');
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            });
        </script>
</body>

</html>