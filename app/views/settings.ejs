<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Settings - WordPress Automation</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/tabs.css">
</head>

<body>
    <%- include('partials/header') %>

        <div class="container">
            <div class="settings-container">
                <h1>Settings</h1>

                <div class="tabs-nav">
                    <button class="tab-btn active" data-tab="tab-automation">Automation Settings</button>
                    <button class="tab-btn" data-tab="tab-keywords">Keywords List</button>
                    <button class="tab-btn" data-tab="tab-prompts">Custom Prompts</button>
                    <button class="tab-btn" data-tab="tab-social">Social Integration</button>
                    <button class="tab-btn" data-tab="tab-image">Image Generation</button>
                    <button class="tab-btn" data-tab="tab-seo">SEO Config</button>
                    <button class="tab-btn" data-tab="tab-ai">AI Settings</button>
                    <button class="tab-btn" data-tab="tab-api">API Keys</button>
                    <button class="tab-btn" data-tab="tab-test-image">Test Image</button>
                    <button class="tab-btn" data-tab="tab-logs">System Logs</button>
                    <button class="tab-btn" data-tab="tab-general">WordPress Configuration</button>
                </div>

                <div id="tab-general" class="tab-content">

                    <div class="card">
                        <div class="card-header">
                            <h2>WordPress Configuration</h2>
                        </div>
                        <div class="card-body">
                            <form id="wpSettingsForm">
                                <div class="form-group">
                                    <label for="wpSiteUrl">WordPress Site URL *</label>
                                    <input type="url" id="wpSiteUrl" name="wpSiteUrl"
                                        value="<%= config.wordpress.siteUrl %>" placeholder="https://yourblog.com"
                                        required>
                                    <small>Your WordPress site URL (without trailing slash)</small>
                                </div>

                                <div class="form-group">
                                    <label for="wpUsername">WordPress Username *</label>
                                    <input type="text" id="wpUsername" name="wpUsername"
                                        value="<%= config.wordpress.username %>" required>
                                </div>

                                <div class="form-group">
                                    <label for="wpAppPassword">Application Password *</label>
                                    <input type="password" id="wpAppPassword" name="wpAppPassword"
                                        value="<%= config.wordpress.appPassword %>" required>
                                    <small>Generate this in WordPress: Users → Profile → Application Passwords</small>
                                </div>

                                <div class="form-actions">
                                    <button type="button" class="btn btn-secondary" onclick="testWordPressConnection()">
                                        Test Connection
                                    </button>
                                    <button type="submit" class="btn btn-primary">Save WordPress Settings</button>
                                </div>
                            </form>
                        </div>
                    </div>

                </div>

                <div id="tab-ai" class="tab-content">
                    <div class="card">
                        <div class="card-header">
                            <h2>OpenAI Configuration</h2>
                        </div>
                        <div class="card-body">
                            <form id="openaiSettingsForm">
                                <div class="form-group">
                                    <label for="openaiApiKey">OpenAI API Key *</label>
                                    <div style="display: flex; gap: 0.5rem;">
                                        <input type="password" id="openaiApiKey" name="openaiApiKey"
                                            value="<%= config.openai.apiKey %>" required style="flex: 1;">
                                        <button type="button" class="btn btn-secondary" onclick="testOpenAI()"
                                            style="white-space: nowrap;">Test Connection</button>
                                    </div>
                                    <small>Get your API key from <a href="https://platform.openai.com/api-keys"
                                            target="_blank">OpenAI Platform</a></small>
                                </div>

                                <div class="form-group"
                                    style="margin-top: 1.5rem; border-top: 1px solid var(--border-color); padding-top: 1.5rem;">
                                    <label for="runwareApiKey">Runware API Key</label>
                                    <input type="password" id="runwareApiKey" name="runwareApiKey"
                                        value="<%= config.runware ? config.runware.apiKey : '' %>"
                                        placeholder="Enter Runware API Key">
                                    <small>Required if using Runware.ai for image generation. Get key from <a
                                            href="https://runware.ai/" target="_blank">Runware Dashboard</a>.</small>
                                </div>

                                <div class="form-actions">
                                    <button type="button" class="btn btn-secondary" onclick="detectModels()">
                                        Detect Available Models
                                    </button>
                                    <button type="submit" class="btn btn-primary">Save OpenAI Settings</button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <h2>AI Models Configuration</h2>
                        </div>
                        <div class="card-body">
                            <form id="aiModelsForm">
                                <div class="form-group">
                                    <label for="contentModel">Content Generation Model</label>
                                    <select id="contentModel" name="contentModel">
                                        <option value="gpt-4o" <%=config.openai.contentModel==='gpt-4o' ? 'selected'
                                            : '' %>
                                            >GPT-4o (Recommended)</option>
                                        <option value="gpt-4-turbo" <%=config.openai.contentModel==='gpt-4-turbo'
                                            ? 'selected' : '' %>>GPT-4 Turbo</option>
                                        <option value="gpt-4" <%=config.openai.contentModel==='gpt-4' ? 'selected' : ''
                                            %>
                                            >GPT-4</option>
                                        <option value="gpt-3.5-turbo" <%=config.openai.contentModel==='gpt-3.5-turbo'
                                            ? 'selected' : '' %>>GPT-3.5 Turbo</option>
                                    </select>
                                    <small>Model used for article generation</small>
                                </div>

                                <div class="form-group">
                                    <label for="imageModel">Image Generation Model</label>
                                    <input type="text" id="imageModel" name="imageModel" list="imageModelList"
                                        value="<%= config.openai.imageModel %>"
                                        placeholder="Select or type model ID...">
                                    <datalist id="imageModelList">
                                        <!-- OpenAI Models -->
                                        <option value="dall-e-3">DALL-E 3 - $0.04</option>
                                        <option value="dall-e-2">DALL-E 2</option>
                                        <option value="gpt-image-1.5">GPT Image 1.5 - $0.009</option>

                                        <!-- Latest Models (Jan 2026) -->
                                        <option value="ImagineArt 1.5 Pro">ImagineArt 1.5 Pro - $0.045</option>
                                        <option value="FLUX.2 [klein] 4B Base">FLUX.2 [klein] 4B Base - $0.0019</option>
                                        <option value="FLUX.2 [klein] 4B">FLUX.2 [klein] 4B - $0.0006</option>
                                        <option value="FLUX.2 [klein] 9B Base">FLUX.2 [klein] 9B Base - $0.00416
                                        </option>

                                        <!-- Qwen Models -->
                                        <option value="Qwen-Image-2512">Qwen-Image-2512 - $0.0051</option>
                                        <option value="Qwen-Image-Layered">Qwen-Image-Layered - $0.0141</option>
                                        <option value="Qwen-Image-Edit-2511">Qwen-Image-Edit-2511 - $0.0122</option>
                                        <option value="Qwen-Image-Edit">Qwen-Image-Edit - $0.0032</option>
                                        <option value="Qwen-Image">Qwen-Image - $0.0058</option>

                                        <!-- FLUX Models -->
                                        <option value="FLUX.2 [max]">FLUX.2 [max] - $0.07</option>
                                        <option value="FLUX.2 [flex]">FLUX.2 [flex] - $0.06</option>
                                        <option value="FLUX.2 [dev]">FLUX.2 [dev] - $0.0051</option>
                                        <option value="FLUX.1 [dev]">FLUX.1 [dev] - $0.0019</option>
                                        <option value="FLUX.1 [schnell]">FLUX.1 [schnell] - $0.0006</option>
                                        <option value="FLUX.1 Krea [dev]">FLUX.1 Krea [dev] - $0.0098</option>
                                        <option value="FLUX.1 Kontext [max]">FLUX.1 Kontext [max] - $0.08</option>
                                        <option value="FLUX.1 Kontext [pro]">FLUX.1 Kontext [pro] - $0.04</option>
                                        <option value="FLUX.1 Kontext [dev]">FLUX.1 Kontext [dev] - $0.0105</option>

                                        <!-- Wan Models -->
                                        <option value="Wan2.6 Image">Wan2.6 Image - $0.03</option>
                                        <option value="Wan2.5-Preview Image">Wan2.5-Preview Image - $0.027</option>

                                        <!-- Kandinsky & Z-Image -->
                                        <option value="Kandinsky 5.0 Image Lite">Kandinsky 5.0 Image Lite - $0.0077
                                        </option>
                                        <option value="Z-Image-Turbo">Z-Image-Turbo - $0.0013</option>

                                        <!-- Riverflow Models -->
                                        <option value="Riverflow 2 Preview Fast">Riverflow 2 Preview Fast - $0.02525
                                        </option>
                                        <option value="Riverflow 2 Preview Standard">Riverflow 2 Preview Standard -
                                            $0.02945</option>
                                        <option value="Riverflow 2 Preview Max">Riverflow 2 Preview Max - $0.06358
                                        </option>
                                        <option value="Riverflow 1.1 Pro">Riverflow 1.1 Pro - $0.077</option>
                                        <option value="Riverflow 1.1 Mini">Riverflow 1.1 Mini - $0.0302</option>
                                        <option value="Riverflow 1.1">Riverflow 1.1 - $0.039</option>

                                        <!-- Bria Models -->
                                        <option value="Bria FIBO">Bria FIBO - $0.04</option>
                                        <option value="Bria 3.2">Bria 3.2 - $0.04</option>
                                        <option value="Bria Image Increase Resolution">Bria Image Increase Resolution -
                                            $0.018</option>

                                        <!-- Seedream Models -->
                                        <option value="Seedream 4.0">Seedream 4.0 - $0.03</option>
                                        <option value="Seedream 3.0">Seedream 3.0 - $0.018</option>
                                        <option value="SeedEdit 3.0">SeedEdit 3.0 - $0.03</option>

                                        <!-- Google Imagen Models -->
                                        <option value="Imagen 4 Ultra">Imagen 4 Ultra - $0.06</option>
                                        <option value="Imagen 4 Fast">Imagen 4 Fast - $0.02</option>
                                        <option value="Imagen 4 Preview">Imagen 4 Preview - $0.04</option>
                                        <option value="Imagen 3">Imagen 3 - $0.04</option>
                                        <option value="Gemini Flash Image 2.5">Gemini Flash Image 2.5 - $0.039</option>

                                        <!-- Stable Diffusion -->
                                        <option value="Stable Diffusion 3">Stable Diffusion 3 - $0.0013</option>
                                        <option value="SD XL v1.0 VAE Fix">SD XL v1.0 VAE Fix - $0.0019</option>

                                        <!-- HiDream Models -->
                                        <option value="HiDream-I1 Full">HiDream-I1 Full - $0.009</option>
                                        <option value="HiDream-I1 Dev">HiDream-I1 Dev - $0.0045</option>
                                        <option value="HiDream-I1 Fast">HiDream-I1 Fast - $0.0038</option>

                                        <!-- Midjourney Models -->
                                        <option value="Midjourney V7">Midjourney V7 - $0.025</option>
                                        <option value="Midjourney V6.1">Midjourney V6.1 - $0.025</option>
                                        <option value="Midjourney V6">Midjourney V6 - $0.025</option>

                                        <!-- Juggernaut Models -->
                                        <option value="Juggernaut Pro Flux">Juggernaut Pro Flux by RunDiffusion -
                                            $0.0042</option>
                                        <option value="Juggernaut Lightning Flux">Juggernaut Lightning Flux - $0.0008
                                        </option>
                                        <option value="civitai:133005@782002">Juggernaut XL V9 - $0.0042</option>

                                        <!-- Video Models -->
                                        <option value="KlingAI 2.1 Master">KlingAI 2.1 Master (Video) - $0.924</option>
                                        <option value="KlingAI 2.0 Master">KlingAI 2.0 Master (Video) - $0.924</option>
                                        <option value="PixVerse v4.5">PixVerse v4.5 (Video) - $0.299</option>
                                        <option value="Vidu Q1">Vidu Q1 (Video) - $0.22</option>

                                        <!-- Other Popular Models -->
                                        <option value="Nano Banana Pro">Nano Banana Pro - $0.138</option>
                                        <option value="Ideogram 2.0">Ideogram 2.0 - $0.08</option>
                                        <option value="ToonYou Beta 6">ToonYou Beta 6 - $0.0006</option>

                                        <!-- Legacy Runware/CivitAI IDs -->
                                        <option value="openai:4@1">Runware ChatGPT Model (Nano Banana)</option>
                                        <option value="runware:100@1">Runware: Realism (Default)</option>
                                        <option value="runware:101@1">Runware: Photorealism</option>
                                        <option value="civitai:4201@130072">Realistic Vision V6.0 B1</option>
                                        <option value="civitai:4384@128713">DreamShaper 8</option>
                                        <option value="civitai:101055@128078">SDXL Unstable Diffusers YamerMIX</option>
                                        <option value="civitai:82098@128713">AbsoluteReality v1.8.1</option>
                                        <option value="civitai:29460@128713">GhostMix V2.0</option>
                                        <option value="civitai:120791@128713">Deliberate V3</option>
                                        <option value="civitai:61372@128713">Rev Animated V1.2.2</option>
                                        <option value="civitai:93931@128713">EpicRealism</option>
                                        <option value="civitai:81458@128078">RealVisXL V4.0</option>
                                        <option value="civitai:112902@128078">Copax TimelessXL</option>
                                        <option value="civitai:20155@128713">MagicMix Realistic V6</option>
                                        <option value="civitai:25685@128713">MeinaMix V11</option>
                                        <option value="civitai:90354@128078">AlbedoBase XL</option>
                                        <option value="civitai:4823@128713">Anything V5</option>
                                        <option value="civitai:64094@128713">CyberRealistic V4.1</option>
                                        <option value="civitai:79290@128713">A-Zovya Photoreal</option>
                                        <option value="civitai:31253@128713">MajicMIX Realistic</option>
                                    </datalist>
                                    <small>Select a preset or type a specific Model ID (e.g., Runware ID).</small>
                                </div>

                                <div class="model-info"
                                    style="background: var(--bg-tertiary); padding: 1rem; border-radius: var(--radius-md); margin-top: 1rem;">
                                    <h4 style="margin-bottom: 0.5rem; font-size: 0.9rem;">Model Information:</h4>
                                    <ul style="font-size: 0.85rem; color: var(--text-muted); margin-left: 1.5rem;">
                                        <li><strong>GPT-Image-1.5:</strong> State-of-the-art, best quality, precise
                                            instructions, excellent text rendering</li>
                                        <li><strong>GPT-Image-1:</strong> High-fidelity visuals, strong
                                            instruction-following</li>
                                        <li><strong>GPT-Image-1-Mini:</strong> Faster and cost-efficient for high-volume
                                            workflows</li>
                                        <li><strong>ChatGPT Image Latest:</strong> Alias pointing to gpt-image-1.5</li>
                                    </ul>
                                </div>

                                <div class="form-actions">
                                    <button type="submit" class="btn btn-primary">Save AI Models</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div id="tab-test-image" class="tab-content">
                    <div class="card">
                        <div class="card-header">
                            <h2>Test Image Generation</h2>
                        </div>
                        <div class="card-body">
                            <form id="testImageForm">
                                <div class="form-group">
                                    <label for="testImageProvider">Provider</label>
                                    <select id="testImageProvider" name="provider">
                                        <optgroup label="AI Image Generation">
                                            <option value="gpt-image-1.5">GPT-Image-1.5 (Latest)</option>
                                            <option value="dall-e-3">DALL-E 3</option>
                                            <option value="runware">Runware.ai</option>
                                        </optgroup>
                                        <optgroup label="Stock Photos">
                                            <option value="unsplash">Unsplash</option>
                                            <option value="pexels">Pexels</option>
                                            <option value="pixabay">Pixabay</option>
                                            <option value="google">Google Search</option>
                                        </optgroup>
                                    </select>
                                </div>

                                <div class="form-group" id="testImageModelGroup">
                                    <label for="testImageModel">Model ID (For Runware/AI)</label>
                                    <input type="text" id="testImageModel" name="model" list="imageModelList"
                                        placeholder="Select or type model ID..." value="runware:100@1">
                                    <small>Leave blank to use default settings.</small>
                                </div>

                                <div class="form-group">
                                    <label for="testImagePrompt">Image Prompt</label>
                                    <textarea id="testImagePrompt" name="prompt" rows="3"
                                        placeholder="Describe the image you want to generate..."
                                        required>Modern luxury home exterior with large glass windows, sunset lighting, photorealistic, 8k</textarea>
                                </div>

                                <div class="form-actions">
                                    <button type="submit" class="btn btn-primary" id="testImageBtn">
                                        Generate Test Image
                                    </button>
                                </div>
                            </form>

                            <div id="testImageResult"
                                style="margin-top: 2rem; display: none; text-align: center; background: var(--bg-tertiary); padding: 1rem; border-radius: var(--radius-md);">
                                <h4 style="margin-bottom: 1rem;">Generated Result:</h4>
                                <div id="testImageLoading" style="display: none; color: var(--text-muted);">
                                    <span class="spinner-border spinner-border-sm"></span> Generating...
                                </div>
                                <img id="testImagePreview" src="" alt="Generated Preview"
                                    style="max-width: 100%; height: auto; border-radius: 4px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
                                <div id="testImageError"
                                    style="color: var(--danger); margin-top: 0.5rem; display: none;">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="tab-social" class="tab-content">
                    <div class="card">
                        <div class="card-header">
                            <h2>Social Media Integration</h2>
                        </div>
                        <div class="card-body">
                            <form id="socialSettingsForm">
                                <h3 style="margin-bottom: 1rem; font-size: 1rem; color: var(--primary-light);">TikTok via Buffer Integration</h3>
                                <div class="form-group">
                                    <label for="bufferAccessToken">Buffer Access Token</label>
                                    <input type="password" id="bufferAccessToken" name="bufferAccessToken"
                                        value="<%= config.social && config.social.buffer ? config.social.buffer.accessToken : '' %>"
                                        placeholder="Enter Buffer Access Token">
                                    <small>Subscription plan: TikTok channel ($6/mo). Connect TikTok to Buffer, then provide API Access.</small>
                                </div>

                                <hr style="margin: 2rem 0; border: 0; border-top: 1px solid var(--border-color);">
                                <h3 style="margin-bottom: 1rem; font-size: 1rem; color: var(--primary-light);">Quick Connect (OAuth)</h3>
                                <p style="margin-bottom: 1rem; color: var(--text-muted); font-size: 0.9rem;">
                                    Connect your social accounts with one click. No need to manually enter API keys.
                                </p>
                                
                                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
                                    <button type="button" class="btn btn-oauth" style="background: #1877f2; color: white; display: flex; align-items: center; justify-content: center; gap: 0.5rem;" onclick="connectOAuth('facebook')">
                                        <span style="font-size: 1.2rem;">📘</span>
                                        <span>Connect Facebook</span>
                                        <span id="fb-status" style="margin-left: auto;"></span>
                                    </button>
                                    
                                    <button type="button" class="btn btn-oauth" style="background: linear-gradient(45deg, #f09433 0%,#e6683c 25%,#dc2743 50%,#cc2366 75%,#bc1888 100%); color: white; display: flex; align-items: center; justify-content: center; gap: 0.5rem;" onclick="connectOAuth('instagram')">
                                        <span style="font-size: 1.2rem;">📷</span>
                                        <span>Connect Instagram</span>
                                        <span id="ig-status" style="margin-left: auto;"></span>
                                    </button>
                                    
                                    <button type="button" class="btn btn-oauth" style="background: #000000; color: white; display: flex; align-items: center; justify-content: center; gap: 0.5rem;" onclick="connectOAuth('twitter')">
                                        <span style="font-size: 1.2rem;">🐦</span>
                                        <span>Connect Twitter</span>
                                        <span id="tw-status" style="margin-left: auto;"></span>
                                    </button>
                                    
                                    <button type="button" class="btn btn-oauth" style="background: #0077b5; color: white; display: flex; align-items: center; justify-content: center; gap: 0.5rem;" onclick="connectOAuth('linkedin')">
                                        <span style="font-size: 1.2rem;">💼</span>
                                        <span>Connect LinkedIn</span>
                                        <span id="li-status" style="margin-left: auto;"></span>
                                    </button>
                                    
                                    <button type="button" class="btn btn-oauth" style="background: #ff0000; color: white; display: flex; align-items: center; justify-content: center; gap: 0.5rem;" onclick="connectOAuth('youtube')">
                                        <span style="font-size: 1.2rem;">📺</span>
                                        <span>Connect Youtube</span>
                                        <span id="yt-status" style="margin-left: auto;"></span>
                                    </button>
                                </div>

                                <hr style="margin: 2rem 0; border: 0; border-top: 1px solid var(--border-color);">
                                <h3 style="margin-bottom: 1rem; font-size: 1rem; color: var(--primary-light);">Manual API Integrations</h3>
                                <p style="margin-bottom: 1rem; color: var(--text-muted); font-size: 0.9rem;">
                                    Advanced: Manually enter API credentials if you prefer not to use OAuth.
                                </p>
                                
                                <h4 style="margin: 1rem 0 0.5rem; font-size: 0.9rem;">Facebook</h4>
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                                    <div class="form-group">
                                        <label for="fbAppId">App ID</label>
                                        <input type="text" id="fbAppId" name="fbAppId" value="<%= config.social && config.social.facebook ? config.social.facebook.appId : '' %>">
                                    </div>
                                    <div class="form-group">
                                        <label for="fbAppSecret">App Secret</label>
                                        <input type="password" id="fbAppSecret" name="fbAppSecret" value="<%= config.social && config.social.facebook ? config.social.facebook.appSecret : '' %>">
                                    </div>
                                </div>
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                                    <div class="form-group">
                                        <label for="fbPageId">Page ID</label>
                                        <input type="text" id="fbPageId" name="fbPageId" value="<%= config.social && config.social.facebook ? config.social.facebook.pageId : '' %>">
                                    </div>
                                    <div class="form-group">
                                        <label for="fbAccessToken">Access Token</label>
                                        <input type="password" id="fbAccessToken" name="fbAccessToken" value="<%= config.social && config.social.facebook ? config.social.facebook.accessToken : '' %>">
                                    </div>
                                </div>

                                <h4 style="margin: 1.5rem 0 0.5rem; font-size: 0.9rem;">Instagram</h4>
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                                    <div class="form-group">
                                        <label for="igAppId">App ID</label>
                                        <input type="text" id="igAppId" name="igAppId" value="<%= config.social && config.social.instagram ? config.social.instagram.appId : '' %>">
                                    </div>
                                    <div class="form-group">
                                        <label for="igAppSecret">App Secret</label>
                                        <input type="password" id="igAppSecret" name="igAppSecret" value="<%= config.social && config.social.instagram ? config.social.instagram.appSecret : '' %>">
                                    </div>
                                </div>
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                                    <div class="form-group">
                                        <label for="igPageId">Page ID (Business Account ID)</label>
                                        <input type="text" id="igPageId" name="igPageId" value="<%= config.social && config.social.instagram ? config.social.instagram.pageId : '' %>">
                                    </div>
                                    <div class="form-group">
                                        <label for="igAccessToken">Access Token</label>
                                        <input type="password" id="igAccessToken" name="igAccessToken" value="<%= config.social && config.social.instagram ? config.social.instagram.accessToken : '' %>">
                                    </div>
                                </div>

                                <h4 style="margin: 1.5rem 0 0.5rem; font-size: 0.9rem;">Twitter (X)</h4>
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                                    <div class="form-group">
                                        <label for="twApiKey">API Key</label>
                                        <input type="text" id="twApiKey" name="twApiKey" value="<%= config.social && config.social.twitter ? config.social.twitter.apiKey : '' %>">
