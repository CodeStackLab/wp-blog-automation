<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Settings - WordPress Automation</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/tabs.css">
</head>

<body>
    <%- include('partials/header') %>

        <div class="container">
            <div class="settings-container">
                <h1>Settings</h1>

                <div class="tabs-nav">
                    <button class="tab-btn active" data-tab="tab-automation">Automation Settings</button>
                    <button class="tab-btn" data-tab="tab-keywords">Keywords List</button>
                    <button class="tab-btn" data-tab="tab-prompts">Custom Prompts</button>
                    <button class="tab-btn" data-tab="tab-image">Image Generation</button>
                    <button class="tab-btn" data-tab="tab-seo">SEO Config</button>
                    <button class="tab-btn" data-tab="tab-ai">AI Settings</button>
                    <button class="tab-btn" data-tab="tab-api">API Keys</button>
                    <button class="tab-btn" data-tab="tab-general">WordPress Configuration</button>
                </div>

                <div id="tab-general" class="tab-content">

                    <div class="card">
                        <div class="card-header">
                            <h2>WordPress Configuration</h2>
                        </div>
                        <div class="card-body">
                            <form id="wpSettingsForm">
                                <div class="form-group">
                                    <label for="wpSiteUrl">WordPress Site URL *</label>
                                    <input type="url" id="wpSiteUrl" name="wpSiteUrl"
                                        value="<%= config.wordpress.siteUrl %>" placeholder="https://yourblog.com"
                                        required>
                                    <small>Your WordPress site URL (without trailing slash)</small>
                                </div>

                                <div class="form-group">
                                    <label for="wpUsername">WordPress Username *</label>
                                    <input type="text" id="wpUsername" name="wpUsername"
                                        value="<%= config.wordpress.username %>" required>
                                </div>

                                <div class="form-group">
                                    <label for="wpAppPassword">Application Password *</label>
                                    <input type="password" id="wpAppPassword" name="wpAppPassword"
                                        value="<%= config.wordpress.appPassword %>" required>
                                    <small>Generate this in WordPress: Users → Profile → Application Passwords</small>
                                </div>

                                <div class="form-actions">
                                    <button type="button" class="btn btn-secondary" onclick="testWordPressConnection()">
                                        Test Connection
                                    </button>
                                    <button type="submit" class="btn btn-primary">Save WordPress Settings</button>
                                </div>
                            </form>
                        </div>
                    </div>

                </div>

                <div id="tab-ai" class="tab-content">
                    <div class="card">
                        <div class="card-header">
                            <h2>OpenAI Configuration</h2>
                        </div>
                        <div class="card-body">
                            <form id="openaiSettingsForm">
                                <div class="form-group">
                                    <label for="openaiApiKey">OpenAI API Key *</label>
                                    <div style="display: flex; gap: 0.5rem;">
                                        <input type="password" id="openaiApiKey" name="openaiApiKey"
                                            value="<%= config.openai.apiKey %>" required style="flex: 1;">
                                        <button type="button" class="btn btn-secondary" onclick="testOpenAI()"
                                            style="white-space: nowrap;">Test Connection</button>
                                    </div>
                                    <small>Get your API key from <a href="https://platform.openai.com/api-keys"
                                            target="_blank">OpenAI Platform</a></small>
                                </div>

                                <div class="form-actions">
                                    <button type="button" class="btn btn-secondary" onclick="detectModels()">
                                        Detect Available Models
                                    </button>
                                    <button type="submit" class="btn btn-primary">Save OpenAI Settings</button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <h2>AI Models Configuration</h2>
                        </div>
                        <div class="card-body">
                            <form id="aiModelsForm">
                                <div class="form-group">
                                    <label for="contentModel">Content Generation Model</label>
                                    <select id="contentModel" name="contentModel">
                                        <option value="gpt-4o" <%=config.openai.contentModel==='gpt-4o' ? 'selected'
                                            : '' %>
                                            >GPT-4o (Recommended)</option>
                                        <option value="gpt-4-turbo" <%=config.openai.contentModel==='gpt-4-turbo'
                                            ? 'selected' : '' %>>GPT-4 Turbo</option>
                                        <option value="gpt-4" <%=config.openai.contentModel==='gpt-4' ? 'selected' : ''
                                            %>
                                            >GPT-4</option>
                                        <option value="gpt-3.5-turbo" <%=config.openai.contentModel==='gpt-3.5-turbo'
                                            ? 'selected' : '' %>>GPT-3.5 Turbo</option>
                                    </select>
                                    <small>Model used for article generation</small>
                                </div>

                                <div class="form-group">
                                    <label for="imageModel">Image Generation Model</label>
                                    <select id="imageModel" name="imageModel">
                                        <option value="gpt-image-1.5" <%=config.openai.imageModel==='gpt-image-1.5'
                                            ? 'selected' : '' %>>GPT-Image-1.5 (Latest & Best) ⭐</option>
                                        <option value="gpt-image-1" <%=config.openai.imageModel==='gpt-image-1'
                                            ? 'selected' : '' %>>GPT-Image-1 (High Fidelity)</option>
                                        <option value="gpt-image-1-mini"
                                            <%=config.openai.imageModel==='gpt-image-1-mini' ? 'selected' : '' %>
                                            >GPT-Image-1-Mini (Cost-Efficient)</option>
                                        <option value="chatgpt-image-latest"
                                            <%=config.openai.imageModel==='chatgpt-image-latest' ? 'selected' : '' %>
                                            >ChatGPT Image Latest</option>
                                        <option value="dall-e-3" <%=config.openai.imageModel==='dall-e-3' ? 'selected'
                                            : '' %>>DALL-E 3 (Deprecated)</option>
                                        <option value="dall-e-2" <%=config.openai.imageModel==='dall-e-2' ? 'selected'
                                            : '' %>>DALL-E 2 (Deprecated)</option>
                                    </select>
                                    <small>Model used for image generation</small>
                                </div>

                                <div class="model-info"
                                    style="background: var(--bg-tertiary); padding: 1rem; border-radius: var(--radius-md); margin-top: 1rem;">
                                    <h4 style="margin-bottom: 0.5rem; font-size: 0.9rem;">Model Information:</h4>
                                    <ul style="font-size: 0.85rem; color: var(--text-muted); margin-left: 1.5rem;">
                                        <li><strong>GPT-Image-1.5:</strong> State-of-the-art, best quality, precise
                                            instructions, excellent text rendering</li>
                                        <li><strong>GPT-Image-1:</strong> High-fidelity visuals, strong
                                            instruction-following</li>
                                        <li><strong>GPT-Image-1-Mini:</strong> Faster and cost-efficient for high-volume
                                            workflows</li>
                                        <li><strong>ChatGPT Image Latest:</strong> Alias pointing to gpt-image-1.5</li>
                                    </ul>
                                </div>

                                <div class="form-actions">
                                    <button type="submit" class="btn btn-primary">Save AI Models</button>
                                </div>
                            </form>
                        </div>
                    </div>

                </div>

                <div id="tab-image" class="tab-content">
                    <div class="card">
                        <div class="card-header">
                            <h2>Image Generation Settings</h2>
                        </div>
                        <div class="card-body">
                            <form id="imageSettingsForm">
                                <h3 style="margin-bottom: 1rem; font-size: 1rem; color: var(--primary-light);">Featured
                                    Image</h3>
                                <div class="form-group">
                                    <label class="toggle-label">
                                        <input type="checkbox" id="imageFeaturedEnabled"
                                            <%=config.imageGeneration.featuredEnabled ? 'checked' : '' %>>
                                        <span class="toggle-switch"></span>
                                        <span>Enable Featured Image</span>
                                    </label>
                                    <small>Generates a main image for the article header</small>
                                </div>

                                <h3
                                    style="margin-top: 1.5rem; margin-bottom: 1rem; font-size: 1rem; color: var(--primary-light);">
                                    Inline Images</h3>
                                <div class="form-group">
                                    <label class="toggle-label">
                                        <input type="checkbox" id="imageInlineEnabled"
                                            <%=config.imageGeneration.inlineEnabled ? 'checked' : '' %>>
                                        <span class="toggle-switch"></span>
                                        <span>Enable Inline Images</span>
                                    </label>
                                    <small>Generates images inside the article content</small>
                                </div>

                                <div class="form-group" id="inlineFrequencyGroup"
                                    style="display: <%= config.imageGeneration.inlineEnabled ? 'block' : 'none' %>;">
                                    <label for="imageInlineFrequency">Inline Image Frequency</label>
                                    <select id="imageInlineFrequency" name="imageInlineFrequency">
                                        <option value="1" <%=config.imageGeneration.inlineFrequency===1 ? 'selected'
                                            : '' %>>After Every Heading</option>
                                        <option value="2" <%=config.imageGeneration.inlineFrequency===2 ? 'selected'
                                            : '' %>>After Every 2nd Heading</option>
                                        <option value="3" <%=config.imageGeneration.inlineFrequency===3 ? 'selected'
                                            : '' %>>After Every 3rd Heading</option>
                                    </select>
                                </div>

                                <h3
                                    style="margin-top: 1.5rem; margin-bottom: 1rem; font-size: 1rem; color: var(--primary-light);">
                                    YouTube Embeds</h3>
                                <div class="form-group">
                                    <label class="toggle-label">
                                        <input type="checkbox" id="youtubeEnabled" <%=config.youtube.enabled ? 'checked'
                                            : '' %>>
                                        <span class="toggle-switch"></span>
                                        <span>Enable YouTube Video Embeds</span>
                                    </label>
                                </div>

                                <div id="youtubeSettings"
                                    style="display: <%= config.youtube.enabled ? 'block' : 'none' %>;">
                                    <div class="form-group">
                                        <label for="youtubeFrequency">Embed Frequency</label>
                                        <select id="youtubeFrequency" name="youtubeFrequency">
                                            <option value="2" <%=config.youtube.frequency===2 ? 'selected' : '' %>>After
                                                Every 2nd Heading</option>
                                            <option value="3" <%=config.youtube.frequency===3 ? 'selected' : '' %>>After
                                                Every 3rd Heading</option>
                                            <option value="5" <%=config.youtube.frequency===5 ? 'selected' : '' %>>After
                                                Every 5th Heading</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="imageSize">Image Size</label>
                                    <select id="imageSize" name="imageSize">
                                        <option value="1200x628" <%=config.imageGeneration.size==='1200x628'
                                            ? 'selected' : '' %>>1200x628 (WordPress Featured - Recommended) ⭐</option>
                                        <option value="1200x900" <%=config.imageGeneration.size==='1200x900'
                                            ? 'selected' : '' %>>1200x900 (4:3 Ratio)</option>
                                        <option value="1024x1024" <%=config.imageGeneration.size==='1024x1024'
                                            ? 'selected' : '' %>>1024x1024 (Square - Social Media)</option>
                                        <option value="1792x1024" <%=config.imageGeneration.size==='1792x1024'
                                            ? 'selected' : '' %>>1792x1024 (Wide Landscape)</option>
                                        <option value="1024x1792" <%=config.imageGeneration.size==='1024x1792'
                                            ? 'selected' : '' %>>1024x1792 (Portrait)</option>
                                    </select>
                                    <small>WordPress recommended: 1200x628 pixels for featured images and social
                                        sharing</small>
                                </div>

                                <div class="form-group">
                                    <label for="imageQuality">Image Quality</label>
                                    <select id="imageQuality" name="imageQuality">
                                        <option value="standard" <%=config.imageGeneration.quality==='standard'
                                            ? 'selected' : '' %>>Standard (Faster, Lower Cost)</option>
                                        <option value="hd" <%=config.imageGeneration.quality==='hd' ? 'selected' : '' %>
                                            >HD
                                            (Higher Quality, Higher Cost)</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label for="imageStyle">Image Style</label>
                                    <select id="imageStyle" name="imageStyle">
                                        <option value="vivid" <%=config.imageGeneration.style==='vivid' ? 'selected'
                                            : '' %>
                                            >Vivid (Hyper-real, Dramatic)</option>
                                        <option value="natural" <%=config.imageGeneration.style==='natural' ? 'selected'
                                            : '' %>>Natural (More Natural, Less Hyper-real)</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label for="imageProvider">Image Provider</label>
                                    <select id="imageProvider" name="imageProvider">
                                        <optgroup label="AI Image Generation">
                                            <option value="gpt-image-1.5"
                                                <%=config.imageGeneration.provider==='gpt-image-1.5' ? 'selected' : ''
                                                %>>GPT-Image-1.5 (Latest & Best) ⭐</option>
                                            <option value="gpt-image-1"
                                                <%=config.imageGeneration.provider==='gpt-image-1' ? 'selected' : '' %>
                                                >GPT-Image-1 (High Fidelity)</option>
                                            <option value="gpt-image-1-mini"
                                                <%=config.imageGeneration.provider==='gpt-image-1-mini' ? 'selected'
                                                : '' %>>GPT-Image-1-Mini (Cost-Efficient)</option>
                                            <option value="chatgpt-image-latest"
                                                <%=config.imageGeneration.provider==='chatgpt-image-latest' ? 'selected'
                                                : '' %>>ChatGPT Image Latest</option>
                                            <option value="dall-e-3" <%=config.imageGeneration.provider==='dall-e-3' ||
                                                config.imageGeneration.provider==='dalle' ? 'selected' : '' %>>DALL-E 3
                                                (Deprecated)</option>
                                            <option value="dall-e-2" <%=config.imageGeneration.provider==='dall-e-2'
                                                ? 'selected' : '' %>>DALL-E 2 (Deprecated)</option>
                                        </optgroup>
                                        <optgroup label="Stock Photos">
                                            <option value="unsplash" <%=config.imageGeneration.provider==='unsplash'
                                                ? 'selected' : '' %>>Unsplash</option>
                                            <option value="pexels" <%=config.imageGeneration.provider==='pexels'
                                                ? 'selected' : '' %>>Pexels</option>
                                            <option value="pixabay" <%=config.imageGeneration.provider==='pixabay'
                                                ? 'selected' : '' %>>Pixabay</option>
                                        </optgroup>
                                    </select>
                                    <small>Choose AI model or stock photo source for image generation</small>
                                </div>



                                <div class="form-actions">
                                    <button type="submit" class="btn btn-primary">Save Image Settings</button>
                                </div>
                            </form>
                        </div>
                    </div>

                </div>

                <div id="tab-keywords" class="tab-content">
                    <div class="card">
                        <div class="card-header">
                            <h2>Keywords Configuration</h2>
                        </div>
                        <div class="card-body">
                            <form id="keywordsForm">
                                <div class="form-group">
                                    <label for="defaultKeywords">Bulk Keywords (comma-separated)</label>
                                    <textarea id="defaultKeywords" name="defaultKeywords" rows="10"
                                        placeholder="technology, innovation, AI, machine learning, cloud computing"><%= config.content.defaultKeywords %></textarea>
                                    <small>Keywords used for topic generation and auto-tagging.</small>
                                </div>
                                <div class="form-actions">
                                    <button type="submit" class="btn btn-primary">Save Keywords</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div id="tab-prompts" class="tab-content">
                    <div class="card">
                        <div class="card-header">
                            <h2>Instructions & Prompts</h2>
                        </div>
                        <div class="card-body">
                            <form id="promptsForm">
                                <div class="form-group">
                                    <label for="customPrompt">Custom Article Prompt (Global)</label>
                                    <textarea id="customPrompt" name="customPrompt" rows="4"
                                        placeholder="Write in a professional tone..."><%= config.content.customPrompt %></textarea>
                                    <small>System prompt appended to all article requests.</small>
                                </div>

                                <div class="form-group">
                                    <label for="articleInstructions">Article Writing Instructions</label>
                                    <textarea id="articleInstructions" name="articleInstructions" rows="4"
                                        placeholder="Write in first person, use conversational tone..."><%= config.content.articleInstructions %></textarea>
                                    <small>Specific style guidelines for the AI.</small>
                                </div>

                                <div class="form-group">
                                    <label for="imageCustomPrompt">Custom Image Prompt (Global)</label>
                                    <textarea id="imageCustomPrompt" name="imageCustomPrompt" rows="3"
                                        placeholder="Photorealistic, cinematic lighting..."><%= config.content.imageCustomPrompt %></textarea>
                                    <small>Additional context for image generation prompts.</small>
                                </div>

                                <h3
                                    style="margin-top: 1.5rem; margin-bottom: 1rem; font-size: 1rem; color: var(--primary-light);">
                                    Article Settings</h3>
                                <div class="form-group">
                                    <label for="articleLength">Article Length (words)</label>
                                    <select id="articleLength" name="articleLength">
                                        <option value="500-800" <%=config.content.articleLength==='500-800' ? 'selected'
                                            : '' %>>Short (500-800 words)</option>
                                        <option value="1000-1500" <%=config.content.articleLength==='1000-1500'
                                            ? 'selected' : '' %>>Medium (1000-1500 words)</option>
                                        <option value="2000-2500" <%=config.content.articleLength==='2000-2500'
                                            ? 'selected' : '' %>>Long (2000-2500 words)</option>
                                        <option value="3000+" <%=config.content.articleLength==='3000+' ? 'selected'
                                            : '' %>>Very Long (3000+ words)</option>
                                    </select>
                                    <small>Target word count for generated articles.</small>
                                </div>

                                <h3
                                    style="margin-top: 1.5rem; margin-bottom: 1rem; font-size: 1rem; color: var(--primary-light);">
                                    Call to Action</h3>
                                <div class="form-group">
                                    <label class="toggle-label">
                                        <input type="checkbox" id="includeCallToAction"
                                            <%=config.content.includeCallToAction ? 'checked' : '' %>>
                                        <span class="toggle-switch"></span>
                                        <span>Include Call to Action at End of Article</span>
                                    </label>
                                    <small>Adds a CTA button/link at the end of every article.</small>
                                </div>
                                <div class="form-group">
                                    <label for="callToActionText">CTA Button Text</label>
                                    <input type="text" id="callToActionText" name="callToActionText"
                                        value="<%= config.content.callToActionText %>" placeholder="Learn more">
                                </div>
                                <div class="form-group">
                                    <label for="callToActionUrl">CTA Button URL</label>
                                    <input type="url" id="callToActionUrl" name="callToActionUrl"
                                        value="<%= config.content.callToActionUrl %>"
                                        placeholder="https://yourwebsite.com/contact">
                                </div>

                                <div class="form-actions">
                                    <button type="submit" class="btn btn-primary">Save Prompts</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div id="tab-seo" class="tab-content">
                    <div class="card">
                        <div class="card-header">
                            <h2>SEO & Structure Settings</h2>
                        </div>
                        <div class="card-body">
                            <form id="seoForm">
                                <div class="form-group">
                                    <label for="imagesPerPost">Images Per Post</label>
                                    <input type="number" id="imagesPerPost" name="imagesPerPost" min="0" max="10"
                                        value="<%= config.content.imagesPerPost %>">
                                    <small>Target number of images (approximate).</small>
                                </div>

                                <h3 style="margin-top: 1.5rem; color: var(--primary-light);">Internal Linking</h3>
                                <div class="form-group">
                                    <label class="toggle-label">
                                        <input type="checkbox" id="includeInternalLinks"
                                            <%=config.content.includeInternalLinks ? 'checked' : '' %>>
                                        <span class="toggle-switch"></span>
                                        <span>Include Internal Links</span>
                                    </label>
                                </div>
                                <div class="form-group">
                                    <label for="internalLinksCount">Number of Internal Links</label>
                                    <input type="number" id="internalLinksCount" name="internalLinksCount" min="0"
                                        max="10" value="<%= config.content.internalLinksCount %>">
                                </div>

                                <h3 style="margin-top: 1.5rem; color: var(--primary-light);">Read Also Section</h3>
                                <div class="form-group">
                                    <label class="toggle-label">
                                        <input type="checkbox" id="includeReadAlso" <%=config.content.includeReadAlso
                                            ? 'checked' : '' %>>
                                        <span class="toggle-switch"></span>
                                        <span>Include "Read Also" Section</span>
                                    </label>
                                </div>
                                <div class="form-group">
                                    <label for="readAlsoCount">Number of Links</label>
                                    <input type="number" id="readAlsoCount" name="readAlsoCount" min="0" max="10"
                                        value="<%= config.content.readAlsoCount %>">
                                </div>


                                <h3 style="margin-top: 1.5rem; color: var(--primary-light);">Outbound Links</h3>
                                <div class="form-group">
                                    <label class="toggle-label">
                                        <input type="checkbox" id="includeOutboundLinks"
                                            <%=config.content.includeOutboundLinks ? 'checked' : '' %>>
                                        <span class="toggle-switch"></span>
                                        <span>Include Outbound/Reference Links</span>
                                    </label>
                                </div>
                                <div class="form-group">
                                    <label for="outboundLinksCount">Number of Outbound Links</label>
                                    <input type="number" id="outboundLinksCount" name="outboundLinksCount" min="0"
                                        max="10" value="<%= config.content.outboundLinksCount %>">
                                </div>

                                <div class="form-actions">
                                    <button type="submit" class="btn btn-primary">Save SEO Settings</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div id="tab-api" class="tab-content">
                    <div class="card">
                        <div class="card-header">
                            <h2>API Keys Configuration</h2>
                        </div>
                        <div class="card-body">
                            <form id="apiKeysForm">
                                <h3 style="margin-bottom: 1rem; font-size: 1rem; color: var(--primary-light);">Editor
                                    Configuration</h3>
                                <div class="form-group">
                                    <label for="tinymceApiKey">TinyMCE API Key</label>
                                    <input type="password" id="tinymceApiKey" name="tinymceApiKey"
                                        value="<%= config.tinymce ? config.tinymce.apiKey : '' %>"
                                        placeholder="Enter TinyMCE API Key">
                                    <small>Required to remove the "API Key Required" warning. Get a free key from <a
                                            href="https://www.tiny.cloud/my-account/dashboard/" target="_blank">Tiny
                                            Cloud</a>.</small>
                                </div>

                                <h3
                                    style="margin-top: 2rem; margin-bottom: 1rem; font-size: 1rem; color: var(--primary-light);">
                                    YouTube API</h3>
                                <div class="form-group">
                                    <label for="youtubeApiKey">YouTube Data API Key</label>
                                    <div style="display: flex; gap: 0.5rem;">
                                        <input type="password" id="youtubeApiKey" name="youtubeApiKey"
                                            value="<%= config.youtube.apiKey %>" placeholder="Enter YouTube API Key"
                                            style="flex: 1;">
                                        <button type="button" class="btn btn-secondary" onclick="testYouTube()"
                                            style="white-space: nowrap;">Test Connection</button>
                                    </div>
                                    <small>Required for video search and embedding. Get it from <a
                                            href="https://console.cloud.google.com/" target="_blank">Google Cloud
                                            Console</a></small>
                                </div>

                                <h3
                                    style="margin-top: 2rem; margin-bottom: 1rem; font-size: 1rem; color: var(--primary-light);">
                                    Stock Image APIs</h3>
                                <div class="form-group">
                                    <label for="unsplashApiKey">Unsplash Access Key</label>
                                    <div style="display: flex; gap: 0.5rem;">
                                        <input type="password" id="unsplashApiKey" name="unsplashApiKey"
                                            value="<%= config.stockImages.unsplashApiKey %>"
                                            placeholder="Enter Unsplash Access Key" style="flex: 1;">
                                        <button type="button" class="btn btn-secondary" onclick="testUnsplash()"
                                            style="white-space: nowrap;">Test Connection</button>
                                    </div>
                                    <small>Get your key from <a href="https://unsplash.com/developers"
                                            target="_blank">Unsplash Developers</a></small>
                                </div>
                                <div class="form-group">
                                    <label for="pexelsApiKey">Pexels API Key</label>
                                    <div style="display: flex; gap: 0.5rem;">
                                        <input type="password" id="pexelsApiKey" name="pexelsApiKey"
                                            value="<%= config.stockImages.pexelsApiKey %>"
                                            placeholder="Enter Pexels API Key" style="flex: 1;">
                                        <button type="button" class="btn btn-secondary" onclick="testPexels()"
                                            style="white-space: nowrap;">Test Connection</button>
                                    </div>
                                    <small>Get your key from <a href="https://www.pexels.com/api/"
                                            target="_blank">Pexels API</a></small>
                                </div>
                                <div class="form-group">
                                    <label for="pixabayApiKey">Pixabay API Key</label>
                                    <div style="display: flex; gap: 0.5rem;">
                                        <input type="password" id="pixabayApiKey" name="pixabayApiKey"
                                            value="<%= config.stockImages.pixabayApiKey %>"
                                            placeholder="Enter Pixabay API Key" style="flex: 1;">
                                        <button type="button" class="btn btn-secondary" onclick="testPixabay()"
                                            style="white-space: nowrap;">Test Connection</button>
                                    </div>
                                    <small>Get your key from <a href="https://pixabay.com/api/docs/"
                                            target="_blank">Pixabay API</a></small>
                                </div>

                                <div class="form-actions">
                                    <button type="submit" class="btn btn-primary">Save API Keys</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div id="tab-automation" class="tab-content active">
                    <div class="card">
                        <div class="card-header">
                            <h2>Automation Settings</h2>
                        </div>
                        <div class="card-body">
                            <form id="automationSettingsForm">
                                <div class="form-group">
                                    <label class="toggle-label">
                                        <input type="checkbox" id="automationEnabled" <%=config.automation.enabled
                                            ? 'checked' : '' %>>
                                        <span class="toggle-switch"></span>
                                        <span>Enable Automatic Publishing</span>
                                    </label>
                                </div>

                                <div class="form-group">
                                    <label for="schedule">Publishing Schedule</label>
                                    <select id="schedule" name="schedule" onchange="toggleScheduleOptions()">
                                        <option value="minutes" <%=config.automation.schedule==='minutes' ? 'selected'
                                            : '' %>>Every X Minutes</option>
                                        <option value="hourly" <%=config.automation.schedule==='hourly' ? 'selected'
                                            : '' %>>Hourly</option>
                                        <option value="daily" <%=config.automation.schedule==='daily' ? 'selected' : ''
                                            %>>Daily</option>
                                        <option value="weekly" <%=config.automation.schedule==='weekly' ? 'selected'
                                            : '' %>>Weekly</option>
                                        <option value="cron" <%=config.automation.schedule==='cron' ? 'selected' : '' %>
                                            >Custom Cron Schedule</option>
                                    </select>
                                </div>

                                <div class="form-group" id="minutesGroup"
                                    style="display: <%= config.automation.schedule === 'minutes' ? 'block' : 'none' %>;">
                                    <label for="minutesInterval">Publish Every (Minutes)</label>
                                    <select id="minutesInterval" name="minutesInterval">
                                        <option value="1" <%=config.automation.minutesInterval===1 ? 'selected' : '' %>
                                            >Every 1 Minute</option>
                                        <option value="5" <%=config.automation.minutesInterval===5 ? 'selected' : '' %>
                                            >Every 5 Minutes</option>
                                        <option value="10" <%=config.automation.minutesInterval===10 ? 'selected' : ''
                                            %>>Every 10 Minutes</option>
                                        <option value="15" <%=config.automation.minutesInterval===15 ? 'selected' : ''
                                            %>>Every 15 Minutes</option>
                                        <option value="30" <%=config.automation.minutesInterval===30 ? 'selected' : ''
                                            %>>Every 30 Minutes</option>
                                    </select>
                                    <small>Articles will be published at regular minute intervals</small>
                                </div>

                                <div class="form-group" id="cronGroup"
                                    style="display: <%= config.automation.schedule === 'cron' ? 'block' : 'none' %>;">
                                    <label for="cronExpression">Cron Expression</label>
                                    <input type="text" id="cronExpression" name="cronExpression"
                                        value="<%= config.automation.cronExpression || '0 9 * * *' %>"
                                        placeholder="e.g. 0 9 * * *">
                                    <small>Standard cron syntax. <a href="https://crontab.guru/" target="_blank">Need
                                            help?</a></small>
                                </div>

                                <div class="form-group">
                                    <label for="dailyArticleLimit">Daily Article Limit</label>
                                    <input type="number" id="dailyArticleLimit" name="dailyArticleLimit" min="1"
                                        max="100" value="<%= config.automation.dailyArticleLimit %>">
                                    <small>Maximum number of articles to publish per day</small>
                                </div>

                                <div class="form-group">
                                    <label class="toggle-label">
                                        <input type="checkbox" id="autoCreateCategories"
                                            <%=config.automation.autoCreateCategories ? 'checked' : '' %>>
                                        <span class="toggle-switch"></span>
                                        <span>Auto-Create Categories</span>
                                    </label>
                                    <small>Automatically create WordPress categories if they don't exist</small>
                                </div>

                                <div class="form-group">
                                    <label class="toggle-label">
                                        <input type="checkbox" id="autoCreateTags" <%=config.automation.autoCreateTags
                                            ? 'checked' : '' %>>
                                        <span class="toggle-switch"></span>
                                        <span>Auto-Create Tags</span>
                                    </label>
                                    <small>Automatically create WordPress tags if they don't exist</small>
                                </div>

                                <div class="form-actions">
                                    <button type="submit" class="btn btn-primary">Save Automation Settings</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div id="notification" class="notification" style="display: none;"></div>
            </div>
        </div>

        <script src="/js/settings.js"></script>
</body>

</html>